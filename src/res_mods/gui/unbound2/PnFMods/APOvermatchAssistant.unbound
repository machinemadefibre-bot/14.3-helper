(def element OA_APOvermatchAssistant() layout=true
	(bindcall externalCall 'inputMapping.onAction' "['createParamsForAllShipsInBattle', {}]" on='addedToStage')

	(scope
		(macro APOA_STAGE_SIZE)

		(macro APOA_GET_USERPREF)
		(macro APOA_GET_PREF_NUMBER _varName="'languageIndex'" _pref="APOA_LOCAL_PREFS.LANGUAGE")
		(macro APOA_GET_PREF_NUMBER _varName="'displayMode'" _pref="APOA_LOCAL_PREFS.MODE")
		(macro APOA_GET_PREF_NUMBER _varName="'scale'" _pref="APOA_LOCAL_PREFS.SCALE")
		(macro APOA_GET_PREF_NUMBER _varName="'backgroundAlpha'" _pref="APOA_LOCAL_PREFS.BACKGROUND_ALPHA")
		(macro APOA_GET_PREF_BOOL _varName="'isPositionLocked'" _pref="APOA_LOCAL_PREFS.DISABLE_DRAGDROP")
		(macro APOA_GET_PREF_BOOL _varName="'debugLoadedEnabled'" _pref="APOA_LOCAL_PREFS.DEBUG_LOADED")

		(var cameraEntity:gfx = "$datahub.getSingleEntity(CC.camera)")
		(var isAltVision:bool = "cameraEntity && cameraEntity.camera ? cameraEntity.camera.altVision : false" (event "cameraEntity.camera.evAltVisionChanged"))
		(var effectiveDisplayMode:number = "isAltVision ? (displayMode == 1 ? 0 : 1) : displayMode")

		(var defaultPos:dict = "{'positionX': (stageWidth / 2 + 72), 'positionY': (stageHeight / 2 + 78)}")
		(macro APOA_GET_DROP_POSITION _elementName="OA_ELEMENT_NAME" _defaultPosition="defaultPos")

		(var vehicleCollection:gfx = "$datahub.getCollection(CC.avatar)")
		(var vehicleCount:number = "vehicleCollection ? vehicleCollection.items.length : 0" (event "vehicleCollection.evAdded") (event "vehicleCollection.evRemoved"))

		(event evOATargetChanged)
		(var currentTarget:gfx = "$event.entity" watch=false init=false (event "evOATargetChanged"))
		(var currentTargetId:number = "currentTarget ? currentTarget.id : 0" (event "evOATargetChanged"))
	)

	(style
		(bind width "stageWidth")
		(bind height "stageHeight")
	)

	(controller $Repeat renderer='OA_TargetTracker'
		(bind count "vehicleCount")
		(args
			_trackedEntity="vehicleCollection.items[$index]"
			_currentTargetId="currentTargetId"
		)
	)

	(element OA_TargetPanelV2
		_markerEntity="currentTarget"
		_dragPosX="dragPosX"
		_dragPosY="dragPosY"
		_scale="scale"
		_languageIndex="languageIndex"
		_displayMode="effectiveDisplayMode"
		_backgroundAlpha="backgroundAlpha"
		_isPositionLocked="isPositionLocked"
		_debugLoadedEnabled="debugLoadedEnabled"
		_defaultPos="defaultPos"
	)

	(element OA_LoadedIndicator
		_visible="debugLoadedEnabled"
		_stageWidth="stageWidth"
		_stageHeight="stageHeight"
		_vehicleCount="vehicleCount"
		_targetId="currentTargetId"
	)
)

(def element OA_TargetTracker(_trackedEntity:gfx, _currentTargetId:number) layout=false
	(scope
		(var trackedId:number = "_trackedEntity ? _trackedEntity.id : 0")
		(var targetComponent:gfx = "_trackedEntity && _trackedEntity.hasComponent(CC.target) ? _trackedEntity.target : null"
			(event "_trackedEntity.evAdded")
			(event "_trackedEntity.evRemoved")
		)
		(var targetFlags:number = "targetComponent ? targetComponent.flags : 0"
			(event "targetComponent.evChanged")
			(event "targetComponent.evFlagsChanged")
		)
		(var isTargetLocked:bool = "(targetFlags & LOCKABLE_WEAPONS) > 0")
	)

	(dispatch evOATargetChanged args="{entity: isTargetLocked ? _trackedEntity : null}" dir="EventDirection.UP"
		(bind enabled "isTargetLocked || _currentTargetId == trackedId")
		(event "targetComponent.evChanged")
		(event "targetComponent.evFlagsChanged")
	)

	(dispatch evOATargetChanged args="{entity: _trackedEntity}" dir="EventDirection.UP" on='addedToStage'
		(bind enabled "isTargetLocked")
	)
)

(def element OA_TargetPanelV2(_markerEntity:gfx, _dragPosX:number, _dragPosY:number, _scale:number, _languageIndex:number, _displayMode:number, _backgroundAlpha:number, _isPositionLocked:bool, _debugLoadedEnabled:bool, _defaultPos:dict) layout=true
	(scope
		(var target:gfx = "_markerEntity && _markerEntity.hasComponent(CC.target) ? _markerEntity.target : null" (event "_markerEntity.evAdded") (event "_markerEntity.evRemoved"))
		(var targetFlags:number = "target ? target.flags : 0" (event "target.evChanged") (event "target.evFlagsChanged"))
		(var isTargetLocked:bool = "(targetFlags & LOCKABLE_WEAPONS) > 0")

		(var relation:gfx = "_markerEntity && _markerEntity.hasComponent(CC.relation) ? _markerEntity.relation : null" (event "_markerEntity.evAdded") (event "_markerEntity.evRemoved"))
		(var isEnemy:bool = "relation && relation.value == SC.Battle.PLAYER_RELATION.ENEMY" (event "relation.evChanged"))
		(var isAlive:bool = "_markerEntity && _markerEntity.hasComponent(CC.health) ? _markerEntity.health.isAlive : false" (event "_markerEntity.health.evIsAliveChanged"))
		(var isTargetVisible:bool = "isTargetLocked && isEnemy && isAlive")

		(var targetAvatar:gfx = "_markerEntity ? _markerEntity.avatar : null" (event "_markerEntity.evAdded") (event "_markerEntity.evRemoved"))
		(var targetShip:gfx = "targetAvatar ? targetAvatar.ship.ref.ship : null")
		(var targetShipId:str = "targetShip ? toString(targetShip.id) : ''")
		(var targetShipNameKey:str = "targetShip && targetShip.name ? toString(targetShip.name) : ''")
		(var targetShipIndexKey:str = "targetShip && targetShip.index ? toString(targetShip.index) : ''")

		(var ownMarkerEntity:gfx = "$datahub.getSingleEntity(CC.selfVehicle)")
		(var ownMarkerAvatar:gfx = "ownMarkerEntity ? ownMarkerEntity.avatar : null" (event "ownMarkerEntity.evAdded") (event "ownMarkerEntity.evRemoved"))
		(var ownMarkerShip:gfx = "ownMarkerAvatar ? ownMarkerAvatar.ship.ref.ship : null" (event "ownMarkerAvatar.evShipRefChanged"))
		(var playerEntity:gfx = "$datahub.getSingleEntity(CC.playerAvatar)")
		(var ownPlayerShip:gfx = "playerEntity && playerEntity.hasComponent(CC.avatar) ? playerEntity.avatar.ship.ref.ship : null")
		(var ownVehicleId:str = "playerEntity && playerEntity.hasComponent(CC.vehicle) ? toString(playerEntity.vehicle.id) : ''" (event "playerEntity.evAdded")(event "playerEntity.evRemoved"))
		(var ownVehicleInfo:gfx = "ownVehicleId != '' ? $datahub.getPrimaryEntity(CC.vehicleInfo, ownVehicleId) : null")
		(var ownAvatar:gfx = "ownVehicleInfo ? ownVehicleInfo.avatar : null" (event "ownVehicleInfo.evAdded")(event "ownVehicleInfo.evRemoved"))
		(var ownShip:gfx = "ownPlayerShip ? ownPlayerShip : ownMarkerShip ? ownMarkerShip : ownAvatar ? ownAvatar.ship.ref.ship : null")
		(var ownShipId:str = "ownShip ? toString(ownShip.id) : ''")
		(var ownShipNameKey:str = "ownShip && ownShip.name ? toString(ownShip.name) : ''")
		(var ownShipIndexKey:str = "ownShip && ownShip.index ? toString(ownShip.index) : ''")

		(var ownDbKey:str = "ownShipId in OA_ARMOR_DB ? ownShipId : ownShipId in OA_ARMOR_ALIAS ? OA_ARMOR_ALIAS[ownShipId] : ownShipNameKey in OA_ARMOR_DB ? ownShipNameKey : ownShipNameKey in OA_ARMOR_ALIAS ? OA_ARMOR_ALIAS[ownShipNameKey] : ownShipIndexKey in OA_ARMOR_DB ? ownShipIndexKey : ownShipIndexKey in OA_ARMOR_ALIAS ? OA_ARMOR_ALIAS[ownShipIndexKey] : ''")
		(var targetDbKey:str = "targetShipId in OA_ARMOR_DB ? targetShipId : targetShipId in OA_ARMOR_ALIAS ? OA_ARMOR_ALIAS[targetShipId] : targetShipNameKey in OA_ARMOR_DB ? targetShipNameKey : targetShipNameKey in OA_ARMOR_ALIAS ? OA_ARMOR_ALIAS[targetShipNameKey] : targetShipIndexKey in OA_ARMOR_DB ? targetShipIndexKey : targetShipIndexKey in OA_ARMOR_ALIAS ? OA_ARMOR_ALIAS[targetShipIndexKey] : ''")
		(var ownRecord:dict = "ownDbKey != '' && ownDbKey in OA_ARMOR_DB ? OA_ARMOR_DB[ownDbKey] : null")
		(var targetRecord:dict = "targetDbKey != '' && targetDbKey in OA_ARMOR_DB ? OA_ARMOR_DB[targetDbKey] : null")
		(var hasOwnRecord:bool = "ownRecord && ownRecord.c > 0")
		(var hasTargetRecord:bool = "targetRecord")
		(var weaponSlots:gfx = "$datahub.getCollection(CC.weaponSlot)")
		(var weaponSlotsCount:number = "weaponSlots ? weaponSlots.items.length : 0" (event "weaponSlots.evAdded") (event "weaponSlots.evRemoved"))
		(var targetMapPosition:gfx = "_markerEntity ? _markerEntity.mapPosition : null" (event "_markerEntity.evAdded") (event "_markerEntity.evRemoved"))
		(var ownMapPosition:gfx = "ownMarkerEntity ? ownMarkerEntity.mapPosition : null" (event "ownMarkerEntity.evAdded") (event "ownMarkerEntity.evRemoved"))
		(var targetPosition:gfx = "targetMapPosition ? targetMapPosition.position : null" (event "evEnterFrame"))
		(var ownPosition:gfx = "ownMapPosition ? ownMapPosition.position : null" (event "evEnterFrame"))
		(var targetPosX:number = "targetPosition ? targetPosition.x : 0" (event "evEnterFrame"))
		(var targetPosY:number = "targetPosition ? targetPosition.y : 0" (event "evEnterFrame"))
		(var ownPosX:number = "ownPosition ? ownPosition.x : 0" (event "evEnterFrame"))
		(var ownPosY:number = "ownPosition ? ownPosition.y : 0" (event "evEnterFrame"))
		(var deltaX:number = "targetPosX - ownPosX" (event "evEnterFrame"))
		(var deltaY:number = "targetPosY - ownPosY" (event "evEnterFrame"))
		(var targetYawDeg:number = "targetMapPosition ? radToGrad(targetMapPosition.yaw) : 0" (event "evEnterFrame"))
		(var ownYawDeg:number = "ownMapPosition ? radToGrad(ownMapPosition.yaw) : 0" (event "evEnterFrame"))
		(var targetBearingDeg:number = "radToGrad(atan2(deltaY, deltaX))" (event "evEnterFrame"))
		(var ownBearingDeg:number = "radToGrad(atan2(-deltaY, -deltaX))" (event "evEnterFrame"))
		(var rawTargetBeltAngleDeg:number = "targetBearingDeg - targetYawDeg - 90" (event "evEnterFrame"))
		(var rawOwnBeltAngleDeg:number = "ownBearingDeg - ownYawDeg - 90" (event "evEnterFrame"))
		(var normalizedTargetBeltAngleDeg:number = "rawTargetBeltAngleDeg > 180 ? rawTargetBeltAngleDeg - 360 : rawTargetBeltAngleDeg < -180 ? rawTargetBeltAngleDeg + 360 : rawTargetBeltAngleDeg" (event "evEnterFrame"))
		(var normalizedOwnBeltAngleDeg:number = "rawOwnBeltAngleDeg > 180 ? rawOwnBeltAngleDeg - 360 : rawOwnBeltAngleDeg < -180 ? rawOwnBeltAngleDeg + 360 : rawOwnBeltAngleDeg" (event "evEnterFrame"))
		(var targetBeltAngleAbs:number = "abs(normalizedTargetBeltAngleDeg)" (event "evEnterFrame"))
		(var ownBeltAngleAbs:number = "abs(normalizedOwnBeltAngleDeg)" (event "evEnterFrame"))
		(var targetBeltObliquityDeg:number = "abs(90 - targetBeltAngleAbs)" (event "evEnterFrame"))
		(var ownBeltObliquityDeg:number = "abs(90 - ownBeltAngleAbs)" (event "evEnterFrame"))
		(var cameraComponent:gfx = "$datahub.getSingleComponent(CC.camera)")
		(var mapSize:number = "cameraComponent && cameraComponent.visibilityRangePerc > 0 ? cameraComponent.visibilityRange / cameraComponent.visibilityRangePerc : 0" (event "evEnterFrame"))
		(var mapRangeKm:number = "mapSize > 0 ? sqrt(pow(deltaX, 2) + pow(deltaY, 2)) * mapSize / 1000 : 0" (event "evEnterFrame"))
		(var crosshairEntity:gfx = "$datahub.getSingleEntity(CC.crosshair)")
		(var aimAssist:gfx = "crosshairEntity ? crosshairEntity.aimAssist : null")
		(var aimAssistRangeKm:number = "aimAssist ? aimAssist.distance : 0" (event "evEnterFrame"))
		(var rangeKm:number = "aimAssistRangeKm > 0 ? aimAssistRangeKm : mapRangeKm" (event "evEnterFrame"))

		# Motion is sampled from visible map position/yaw only.
		(var timerEntity:gfx = "$datahub.getSingleEntity(CC.timer)")
		(var motionTickCount:number = "0" watch=false)
		(bind motionTickCount "motionTickCount + 1" init=false watch=false (event "timerEntity.timer.evFrequent"))

		(event evOAMotionSample)
		(var targetSampleX:number = "0" watch=false)
		(bind targetSampleX "$event.targetX" init=false watch=false (event "evOAMotionSample"))
		(var targetSampleY:number = "0" watch=false)
		(bind targetSampleY "$event.targetY" init=false watch=false (event "evOAMotionSample"))
		(var targetSampleYaw:number = "0" watch=false)
		(bind targetSampleYaw "$event.targetYaw" init=false watch=false (event "evOAMotionSample"))
		(var targetSampleVisible:bool = "false" watch=false)
		(bind targetSampleVisible "$event.targetVisible" init=false watch=false (event "evOAMotionSample"))
		(var targetSampleKey:str = "''" watch=false)
		(bind targetSampleKey "$event.targetKey" init=false watch=false (event "evOAMotionSample"))
		(var ownSampleX:number = "0" watch=false)
		(bind ownSampleX "$event.ownX" init=false watch=false (event "evOAMotionSample"))
		(var ownSampleY:number = "0" watch=false)
		(bind ownSampleY "$event.ownY" init=false watch=false (event "evOAMotionSample"))
		(var ownSampleYaw:number = "0" watch=false)
		(bind ownSampleYaw "$event.ownYaw" init=false watch=false (event "evOAMotionSample"))
		(var ownSampleVisible:bool = "false" watch=false)
		(bind ownSampleVisible "$event.ownVisible" init=false watch=false (event "evOAMotionSample"))
		(var ownSampleKey:str = "''" watch=false)
		(bind ownSampleKey "$event.ownKey" init=false watch=false (event "evOAMotionSample"))
		(dispatch evOAMotionSample args = "{targetX: round(targetPosX * 100000), targetY: round(targetPosY * 100000), targetYaw: targetYawDeg, targetVisible: isTargetVisible, targetKey: targetDbKey, ownX: round(ownPosX * 100000), ownY: round(ownPosY * 100000), ownYaw: ownYawDeg, ownVisible: ownMapPosition ? true : false, ownKey: ownDbKey}"
			(bind trigger "floor(motionTickCount / 3)")
		)

		(event evOAMotionState)
		(var targetPrevX:number = "0" watch=false)
		(bind targetPrevX "$event.targetPrevX" init=false watch=false (event "evOAMotionState"))
		(var targetPrevY:number = "0" watch=false)
		(bind targetPrevY "$event.targetPrevY" init=false watch=false (event "evOAMotionState"))
		(var targetPrevYaw:number = "0" watch=false)
		(bind targetPrevYaw "$event.targetPrevYaw" init=false watch=false (event "evOAMotionState"))
		(var targetPrevVisible:bool = "false" watch=false)
		(bind targetPrevVisible "$event.targetPrevVisible" init=false watch=false (event "evOAMotionState"))
		(var targetPrevKey:str = "''" watch=false)
		(bind targetPrevKey "$event.targetPrevKey" init=false watch=false (event "evOAMotionState"))
		(var targetMotionValid:bool = "false" watch=false)
		(bind targetMotionValid "$event.targetMotionValid" init=false watch=false (event "evOAMotionState"))
		(var targetSampleDx:number = "0" watch=false)
		(bind targetSampleDx "$event.targetDx" init=false watch=false (event "evOAMotionState"))
		(var targetSampleDy:number = "0" watch=false)
		(bind targetSampleDy "$event.targetDy" init=false watch=false (event "evOAMotionState"))
		(var targetYawDeltaDeg:number = "0" watch=false)
		(bind targetYawDeltaDeg "$event.targetYawDeltaDeg" init=false watch=false (event "evOAMotionState"))
		(var targetYawRateDegPerSec:number = "0" watch=false)
		(bind targetYawRateDegPerSec "$event.targetYawRateDegPerSec" init=false watch=false (event "evOAMotionState"))
		(var targetDiffSpeedKnots:number = "0" watch=false)
		(bind targetDiffSpeedKnots "$event.targetDiffSpeedKnots" init=false watch=false (event "evOAMotionState"))
		(var ownPrevX:number = "0" watch=false)
		(bind ownPrevX "$event.ownPrevX" init=false watch=false (event "evOAMotionState"))
		(var ownPrevY:number = "0" watch=false)
		(bind ownPrevY "$event.ownPrevY" init=false watch=false (event "evOAMotionState"))
		(var ownPrevYaw:number = "0" watch=false)
		(bind ownPrevYaw "$event.ownPrevYaw" init=false watch=false (event "evOAMotionState"))
		(var ownPrevVisible:bool = "false" watch=false)
		(bind ownPrevVisible "$event.ownPrevVisible" init=false watch=false (event "evOAMotionState"))
		(var ownPrevKey:str = "''" watch=false)
		(bind ownPrevKey "$event.ownPrevKey" init=false watch=false (event "evOAMotionState"))
		(var ownMotionValid:bool = "false" watch=false)
		(bind ownMotionValid "$event.ownMotionValid" init=false watch=false (event "evOAMotionState"))
		(var ownSampleDx:number = "0" watch=false)
		(bind ownSampleDx "$event.ownDx" init=false watch=false (event "evOAMotionState"))
		(var ownSampleDy:number = "0" watch=false)
		(bind ownSampleDy "$event.ownDy" init=false watch=false (event "evOAMotionState"))
		(var ownYawDeltaDeg:number = "0" watch=false)
		(bind ownYawDeltaDeg "$event.ownYawDeltaDeg" init=false watch=false (event "evOAMotionState"))
		(var ownYawRateDegPerSec:number = "0" watch=false)
		(bind ownYawRateDegPerSec "$event.ownYawRateDegPerSec" init=false watch=false (event "evOAMotionState"))
		(var ownDiffSpeedKnots:number = "0" watch=false)
		(bind ownDiffSpeedKnots "$event.ownDiffSpeedKnots" init=false watch=false (event "evOAMotionState"))
		(dispatch evOAMotionState args = "{targetPrevX: targetSampleX, targetPrevY: targetSampleY, targetPrevYaw: targetSampleYaw, targetPrevVisible: targetSampleVisible, targetPrevKey: targetSampleKey, targetMotionValid: targetPrevVisible && targetSampleVisible && targetPrevKey == targetSampleKey, targetDx: targetSampleX - targetPrevX, targetDy: targetSampleY - targetPrevY, targetYawDeltaDeg: (targetSampleYaw - targetPrevYaw) > 180 ? (targetSampleYaw - targetPrevYaw) - 360 : (targetSampleYaw - targetPrevYaw) < -180 ? (targetSampleYaw - targetPrevYaw) + 360 : (targetSampleYaw - targetPrevYaw), targetYawRateDegPerSec: targetPrevVisible && targetSampleVisible && targetPrevKey == targetSampleKey ? max(-20, min(20, ((targetSampleYaw - targetPrevYaw) > 180 ? (targetSampleYaw - targetPrevYaw) - 360 : (targetSampleYaw - targetPrevYaw) < -180 ? (targetSampleYaw - targetPrevYaw) + 360 : (targetSampleYaw - targetPrevYaw)) / 0.15)) : 0, targetDiffSpeedKnots: targetPrevVisible && targetSampleVisible && targetPrevKey == targetSampleKey && mapSize > 0 ? min(targetRecord && targetRecord.ty == 'D' ? 50 : targetRecord && targetRecord.ty == 'C' ? 45 : targetRecord && targetRecord.ty == 'B' ? 38 : targetRecord && targetRecord.ty == 'A' ? 35 : 40, max(0, 0.025733333 * sqrt(pow(targetSampleX - targetPrevX, 2) + pow(targetSampleY - targetPrevY, 2)) * mapSize)) : 0, ownPrevX: ownSampleX, ownPrevY: ownSampleY, ownPrevYaw: ownSampleYaw, ownPrevVisible: ownSampleVisible, ownPrevKey: ownSampleKey, ownMotionValid: ownPrevVisible && ownSampleVisible && ownPrevKey == ownSampleKey, ownDx: ownSampleX - ownPrevX, ownDy: ownSampleY - ownPrevY, ownYawDeltaDeg: (ownSampleYaw - ownPrevYaw) > 180 ? (ownSampleYaw - ownPrevYaw) - 360 : (ownSampleYaw - ownPrevYaw) < -180 ? (ownSampleYaw - ownPrevYaw) + 360 : (ownSampleYaw - ownPrevYaw), ownYawRateDegPerSec: ownPrevVisible && ownSampleVisible && ownPrevKey == ownSampleKey ? max(-20, min(20, ((ownSampleYaw - ownPrevYaw) > 180 ? (ownSampleYaw - ownPrevYaw) - 360 : (ownSampleYaw - ownPrevYaw) < -180 ? (ownSampleYaw - ownPrevYaw) + 360 : (ownSampleYaw - ownPrevYaw)) / 0.15)) : 0, ownDiffSpeedKnots: ownPrevVisible && ownSampleVisible && ownPrevKey == ownSampleKey && mapSize > 0 ? min(ownRecord && ownRecord.ty == 'D' ? 50 : ownRecord && ownRecord.ty == 'C' ? 45 : ownRecord && ownRecord.ty == 'B' ? 38 : ownRecord && ownRecord.ty == 'A' ? 35 : 40, max(0, 0.025733333 * sqrt(pow(ownSampleX - ownPrevX, 2) + pow(ownSampleY - ownPrevY, 2)) * mapSize)) : 0}"
			dir=0 (event "evOAMotionSample")
		)

		(var selfVehicleWatcher:gfx = "$datahub.getFirstWatcher(CC.selfVehicle)")
		(var selfVehicleEntity:gfx = "selfVehicleWatcher.entity" (event "selfVehicleWatcher.event"))
		(var weaponController:gfx = "selfVehicleEntity ? selfVehicleEntity.weaponController : null" (event "selfVehicleEntity.evAdded") (event "selfVehicleEntity.evRemoved"))
		(var selectedWeaponType:number = "weaponController ? weaponController.selectedWeapon : SC.Ships.SHIP_WEAPON_TYPES.NONE" (event "weaponController.evSelectedWeaponChanged"))
		(var isFallbackArtillerySelected:bool = "selectedWeaponType == SC.Ships.SHIP_WEAPON_TYPES.ARTILLERY")
		(var selectedAmmoText:str = "weaponController && weaponController.selectedAmmo ? toLower(toString(weaponController.selectedAmmo)) : ''" (event "weaponController.evSelectedAmmoTypeChanged") (event "weaponController.evSelectedWeaponChanged"))
		(var fallbackIsSapAmmo:bool = "selectedAmmoText == 'cs' || selectedAmmoText == 'sap' || selectedAmmoText == 'ammo_cs' || selectedAmmoText == 'type_cs'")
		(var fallbackIsHeAmmo:bool = "selectedAmmoText == 'he' || selectedAmmoText == 'ammo_he' || selectedAmmoText == 'type_he'")
		(var fallbackIsApAmmo:bool = "!fallbackIsSapAmmo && !fallbackIsHeAmmo")
		(var fallbackIsDefenseMode:bool = "_displayMode == 1")
		(var fallbackEnemyCaliber:number = "targetRecord ? targetRecord.c : 0")
		(var fallbackEnemyHePen:number = "targetRecord ? targetRecord.he : 0")
		(var fallbackEnemySapPen:number = "targetRecord ? targetRecord.sap : 0")
		(var fallbackOwnCaliber:number = "ownRecord ? ownRecord.c : 0")
		(var fallbackOwnHePen:number = "ownRecord ? ownRecord.he : 0")
		(var fallbackOwnSapPen:number = "ownRecord ? ownRecord.sap : 0")
		(var fallbackIsDefenseSapMode:bool = "fallbackIsDefenseMode && fallbackEnemySapPen > 0")
		(var fallbackIsDefenseHeMode:bool = "fallbackIsDefenseMode && !fallbackIsDefenseSapMode && fallbackEnemyCaliber > 0 && fallbackEnemyCaliber < 283")
		(var fallbackRuleLimit:number = "fallbackIsDefenseSapMode ? fallbackEnemySapPen : fallbackIsDefenseHeMode ? fallbackEnemyHePen : fallbackIsDefenseMode ? fallbackEnemyCaliber * 10 : fallbackIsHeAmmo ? fallbackOwnHePen : fallbackIsSapAmmo ? fallbackOwnSapPen : fallbackOwnCaliber * 10")
		(var fallbackRuleScale:number = "fallbackIsDefenseSapMode || fallbackIsDefenseHeMode ? 1 : fallbackIsDefenseMode || fallbackIsApAmmo ? 143 : 1")
		(var fallbackArmorRecord:dict = "fallbackIsDefenseMode ? ownRecord : targetRecord")
		(var fallbackShellRecord:dict = "fallbackIsDefenseMode ? targetRecord : ownRecord")
		(var fallbackRuleDbKey:str = "fallbackIsDefenseMode ? targetDbKey : ownDbKey")
		(var fallbackRuleCaliber:number = "fallbackIsDefenseMode ? fallbackEnemyCaliber : fallbackOwnCaliber")
		(var fallbackBeltObliquityDeg:number = "fallbackIsDefenseMode ? ownBeltObliquityDeg : targetBeltObliquityDeg")
		(var fallbackBeltAngleDeg:number = "fallbackIsDefenseMode ? normalizedOwnBeltAngleDeg : normalizedTargetBeltAngleDeg")
		(var fallbackYawRateDegPerSec:number = "fallbackIsDefenseMode ? ownYawRateDegPerSec : targetYawRateDegPerSec")
		(var fallbackDiffSpeedKnots:number = "fallbackIsDefenseMode ? ownDiffSpeedKnots : targetDiffSpeedKnots")
		(var isTargetSubmarine:bool = "targetRecord && targetRecord.ty == 'S'")
		(var isFallbackPanelVisible:bool = "isTargetVisible && !isTargetSubmarine && weaponSlotsCount == 0 && (fallbackIsDefenseMode || isFallbackArtillerySelected || fallbackOwnCaliber > 0)")
	)

	(element OA_RulePanel
		_visible="isFallbackPanelVisible"
		_ruleLimit="fallbackRuleLimit"
		_ruleScale="fallbackRuleScale"
		_displayMode="_displayMode"
		_shellRecord="fallbackShellRecord"
		_ownDbKey="fallbackRuleDbKey"
		_ownCaliber="fallbackRuleCaliber"
		_targetRecord="fallbackArmorRecord"
		_rangeKm="rangeKm"
		_beltObliquityDeg="fallbackBeltObliquityDeg"
		_beltAngleDeg="fallbackBeltAngleDeg"
		_yawRateDegPerSec="fallbackYawRateDegPerSec"
		_diffSpeedKnots="fallbackDiffSpeedKnots"
		_dragPosX="_dragPosX"
		_dragPosY="_dragPosY"
		_scale="_scale"
		_languageIndex="_languageIndex"
		_backgroundAlpha="_backgroundAlpha"
		_isPositionLocked="_isPositionLocked"
		_debugLoadedEnabled="_debugLoadedEnabled"
		_defaultPos="_defaultPos"
	)

	(controller $Repeat renderer='OA_AmmoPanel'
		(bind count "weaponSlotsCount")
		(args
			_slot="weaponSlots.items[$index]"
			_isTargetVisible="isTargetVisible"
			_ownRecord="ownRecord"
			_targetRecord="targetRecord"
			_hasOwnRecord="hasOwnRecord"
			_hasTargetRecord="hasTargetRecord"
			_ownShipId="ownShipId"
			_ownShipNameKey="ownShipNameKey"
			_ownShipIndexKey="ownShipIndexKey"
			_ownDbKey="ownDbKey"
			_targetShipId="targetShipId"
			_targetShipNameKey="targetShipNameKey"
			_targetShipIndexKey="targetShipIndexKey"
			_targetDbKey="targetDbKey"
			_rangeKm="rangeKm"
			_targetBeltObliquityDeg="targetBeltObliquityDeg"
			_ownBeltObliquityDeg="ownBeltObliquityDeg"
			_targetBeltAngleDeg="normalizedTargetBeltAngleDeg"
			_ownBeltAngleDeg="normalizedOwnBeltAngleDeg"
			_targetYawRateDegPerSec="targetYawRateDegPerSec"
			_ownYawRateDegPerSec="ownYawRateDegPerSec"
			_targetDiffSpeedKnots="targetDiffSpeedKnots"
			_ownDiffSpeedKnots="ownDiffSpeedKnots"
			_dragPosX="_dragPosX"
			_dragPosY="_dragPosY"
			_scale="_scale"
			_languageIndex="_languageIndex"
			_displayMode="_displayMode"
			_backgroundAlpha="_backgroundAlpha"
			_isPositionLocked="_isPositionLocked"
			_debugLoadedEnabled="_debugLoadedEnabled"
			_defaultPos="_defaultPos"
		)
	)
)

(def element OA_AmmoPanel(_slot:gfx, _isTargetVisible:bool, _ownRecord:dict, _targetRecord:dict, _hasOwnRecord:bool, _hasTargetRecord:bool, _ownShipId:str, _ownShipNameKey:str, _ownShipIndexKey:str, _ownDbKey:str, _targetShipId:str, _targetShipNameKey:str, _targetShipIndexKey:str, _targetDbKey:str, _rangeKm:number, _targetBeltObliquityDeg:number, _ownBeltObliquityDeg:number, _targetBeltAngleDeg:number, _ownBeltAngleDeg:number, _targetYawRateDegPerSec:number, _ownYawRateDegPerSec:number, _targetDiffSpeedKnots:number, _ownDiffSpeedKnots:number, _dragPosX:number, _dragPosY:number, _scale:number, _languageIndex:number, _displayMode:number, _backgroundAlpha:number, _isPositionLocked:bool, _debugLoadedEnabled:bool, _defaultPos:dict) layout=true
	(scope
		(var slotWeapon:gfx = "_slot ? _slot.weaponSlot : null" (event "_slot.evAdded") (event "_slot.evRemoved"))
		(var slotType:number = "slotWeapon ? slotWeapon.type : -1")
		(var slotId:str = "slotWeapon ? toString(slotWeapon.id) : ''" (event "slotWeapon.evStateChanged"))
		(var isSlotActive:bool = "slotWeapon ? slotWeapon.active : false" (event "slotWeapon.evActiveChanged") (event "slotWeapon.evSelectedChanged"))
		(var isArtillerySlot:bool = "slotType == SC.Ships.SHIP_WEAPON_TYPES.ARTILLERY")

		(var ammoEntity:gfx = "slotId != '' ? $datahub.getPrimaryEntity(CC.ammo, slotId) : null")
		(var ammoComponent:gfx = "ammoEntity ? ammoEntity.ammo : null" (event "ammoEntity.evAdded") (event "ammoEntity.evRemoved"))
		(var ammoView:gfx = "ammoComponent ? ammoComponent.viewData : null" (event "ammoComponent.evUpdated"))
		(var ammoParamsLower:str = "ammoView && ammoView.paramsDescriptor ? toLower(toString(ammoView.paramsDescriptor)) : ''" (event "ammoComponent.evUpdated"))
		(var isSapAmmo:bool = "ammoParamsLower == 'cs'")
		(var isHeAmmo:bool = "ammoParamsLower == 'he'")
		(var isApAmmo:bool = "ammoParamsLower == 'ap'")
		(var isSupportedAmmo:bool = "isApAmmo || isHeAmmo || isSapAmmo")
		(var isDefenseMode:bool = "_displayMode == 1")

		(var ownCaliber:number = "_ownRecord ? _ownRecord.c : 0")
		(var ownHePen:number = "_ownRecord ? _ownRecord.he : 0")
		(var ownSapPen:number = "_ownRecord ? _ownRecord.sap : 0")
		(var enemyCaliber:number = "_targetRecord ? _targetRecord.c : 0")
		(var enemyHePen:number = "_targetRecord ? _targetRecord.he : 0")
		(var enemySapPen:number = "_targetRecord ? _targetRecord.sap : 0")
		(var isDefenseSapMode:bool = "isDefenseMode && enemySapPen > 0")
		(var isDefenseHeMode:bool = "isDefenseMode && !isDefenseSapMode && enemyCaliber > 0 && enemyCaliber < 283")
		(var ownApRuleLimit:number = "ownCaliber * 10")
		(var enemyApRuleLimit:number = "enemyCaliber * 10")
		(var selectedRuleLimit:number = "isDefenseSapMode ? enemySapPen : isDefenseHeMode ? enemyHePen : isDefenseMode ? enemyApRuleLimit : isApAmmo ? ownApRuleLimit : isHeAmmo ? ownHePen : isSapAmmo ? ownSapPen : 0")
		(var selectedRuleScale:number = "isDefenseSapMode || isDefenseHeMode ? 1 : isDefenseMode || isApAmmo ? 143 : 1")
		(var selectedArmorRecord:dict = "isDefenseMode ? _ownRecord : _targetRecord")
		(var selectedShellRecord:dict = "isDefenseMode ? _targetRecord : _ownRecord")
		(var selectedRuleDbKey:str = "isDefenseMode ? _targetDbKey : _ownDbKey")
		(var selectedRuleCaliber:number = "isDefenseMode ? enemyCaliber : ownCaliber")
		(var selectedBeltObliquityDeg:number = "isDefenseMode ? _ownBeltObliquityDeg : _targetBeltObliquityDeg")
		(var selectedBeltAngleDeg:number = "isDefenseMode ? _ownBeltAngleDeg : _targetBeltAngleDeg")
		(var selectedYawRateDegPerSec:number = "isDefenseMode ? _ownYawRateDegPerSec : _targetYawRateDegPerSec")
		(var selectedDiffSpeedKnots:number = "isDefenseMode ? _ownDiffSpeedKnots : _targetDiffSpeedKnots")
		(var isTargetSubmarine:bool = "_targetRecord && _targetRecord.ty == 'S'")
		(var isPanelVisible:bool = "_isTargetVisible && !isTargetSubmarine && isArtillerySlot && (isDefenseMode || (isSlotActive && isSupportedAmmo))")
	)

	(element OA_RulePanel
		_visible="isPanelVisible"
		_ruleLimit="selectedRuleLimit"
		_ruleScale="selectedRuleScale"
		_displayMode="_displayMode"
		_shellRecord="selectedShellRecord"
		_ownDbKey="selectedRuleDbKey"
		_ownCaliber="selectedRuleCaliber"
		_targetRecord="selectedArmorRecord"
		_rangeKm="_rangeKm"
		_beltObliquityDeg="selectedBeltObliquityDeg"
		_beltAngleDeg="selectedBeltAngleDeg"
		_yawRateDegPerSec="selectedYawRateDegPerSec"
		_diffSpeedKnots="selectedDiffSpeedKnots"
		_dragPosX="_dragPosX"
		_dragPosY="_dragPosY"
		_scale="_scale"
		_languageIndex="_languageIndex"
		_backgroundAlpha="_backgroundAlpha"
		_isPositionLocked="_isPositionLocked"
		_debugLoadedEnabled="_debugLoadedEnabled"
		_defaultPos="_defaultPos"
	)
)

(def element OA_RulePanel(_visible:bool, _ruleLimit:number, _ruleScale:number, _displayMode:number, _shellRecord:dict, _ownDbKey:str, _ownCaliber:number, _targetRecord:dict, _rangeKm:number, _beltObliquityDeg:number, _beltAngleDeg:number, _yawRateDegPerSec:number, _diffSpeedKnots:number, _dragPosX:number, _dragPosY:number, _scale:number, _languageIndex:number, _backgroundAlpha:number, _isPositionLocked:bool, _debugLoadedEnabled:bool, _defaultPos:dict) layout=true
	(scope
		(event evOASettingsToggle)
		(var settingsOpen:bool = "false" watch=false)
		(bind settingsOpen "!settingsOpen" init=false watch=false (event "evOASettingsToggle"))
		(var mouse:gfx = "$datahub.getSingleComponent(CC.mouse)")
		(var isMouseActive:bool = "mouse.active" (event "mouse.evActiveChanged"))
		(var isChinese:bool = "_languageIndex == 1")
		(var isDefenseMode:bool = "_displayMode == 1")
		(var labelModePrefix:str = "isChinese ? (isDefenseMode ? '防' : '攻') : (isDefenseMode ? 'DEF' : 'ATK')")
		(var labelBowStern:str = "isChinese ? '艏艉' : 'Bow/Stern'")
		(var labelDeck:str = "isChinese ? '甲板' : 'Deck'")
		(var labelSide:str = "isChinese ? '侧板' : 'Side'")
		(var labelMainBelt:str = "isChinese ? '主带' : 'Belt'")
		(var labelBelt:str = "isChinese ? '延伸' : 'Ext'")
		(var labelBeltBow:str = "isChinese ? '前' : 'Bow'")
		(var labelBeltStern:str = "isChinese ? '后' : 'Stern'")
		(var textNoBelt:str = "isChinese ? '无' : 'NA'")
		(var hasTargetArmorRecord:bool = "_targetRecord")
		(var hasRule:bool = "_ruleLimit > 0")
		(var hasApTable:bool = "_shellRecord && _shellRecord.apv && _shellRecord.apv.length >= 7 && _shellRecord.api && _shellRecord.api.length >= 7")
		(var hasApHorizontalTable:bool = "hasApTable && _shellRecord.aph && _shellRecord.aph.length >= 7")
		(var hasApFlightTimeTable:bool = "hasApTable && _shellRecord.apt && _shellRecord.apt.length >= 7")
		(var isApRule:bool = "_ruleScale == 143 && hasApTable")
		(var apRangeBucket:number = "_rangeKm <= 2.5 ? 0 : _rangeKm <= 7.5 ? 1 : _rangeKm <= 12.5 ? 2 : _rangeKm <= 17.5 ? 3 : _rangeKm <= 22.5 ? 4 : _rangeKm <= 27.5 ? 5 : 6")
		(var apPenetrationMm:number = "hasApTable ? _shellRecord.apv[apRangeBucket] : 0")
		(var apHorizontalPenetrationMm:number = "hasApHorizontalTable ? _shellRecord.aph[apRangeBucket] : 0")
		(var apImpactAngleDeg:number = "hasApTable ? _shellRecord.api[apRangeBucket] : 0")
		(var apTrajectoryPenetrationMm:number = "apPenetrationMm")
		(var apFlightTimeSec:number = "hasApFlightTimeTable ? _shellRecord.apt[apRangeBucket] : 0")
		(var predictedYawDeltaDeg:number = "max(-180, min(180, _yawRateDegPerSec * apFlightTimeSec))")
		(var predictedBeltAngleRawDeg:number = "_beltAngleDeg - predictedYawDeltaDeg")
		(var predictedBeltAngleDeg:number = "predictedBeltAngleRawDeg > 180 ? predictedBeltAngleRawDeg - 360 : predictedBeltAngleRawDeg < -180 ? predictedBeltAngleRawDeg + 360 : predictedBeltAngleRawDeg")
		(var predictedBeltAngleAbs:number = "abs(predictedBeltAngleDeg)")
		(var predictedBeltObliquityDeg:number = "abs(90 - predictedBeltAngleAbs)")
		(var apRelativeHeadingDeg:number = "max(0, 90 - predictedBeltObliquityDeg)")
		(var apNoRicochetHeadingDeg:number = "hasApTable ? max(0, 90 - _shellRecord.ar) : 0")
		(var apAlwaysRicochetHeadingDeg:number = "hasApTable ? max(0, 90 - _shellRecord.aa) : 0")
		(var apDeckNoRicochetFallDeg:number = "hasApTable ? max(0, 90 - _shellRecord.ar) : 90")
		(var apDeckSideOnly:bool = "isApRule && apImpactAngleDeg > apDeckNoRicochetFallDeg")
		(var apRawMainBeltOnly:bool = "isApRule && !apDeckSideOnly && apRelativeHeadingDeg >= apAlwaysRicochetHeadingDeg")
		(var apRawOvermatchRows:bool = "isApRule && !apDeckSideOnly && !apRawMainBeltOnly")
		(var apRawModeCode:number = "apRawMainBeltOnly ? 1 : apRawOvermatchRows ? 0 : -1")
		(var timerEntity:gfx = "$datahub.getSingleEntity(CC.timer)")
		(var apModeTick:number = "0" watch=false)
		(bind apModeTick "apModeTick + 1" init=false watch=false (event "timerEntity.timer.evFrequent"))
		(event evOAModeFlapState)
		(var apLastModeCode:number = "-1" watch=false)
		(bind apLastModeCode "$event.lastModeCode" init=false watch=false (event "evOAModeFlapState"))
		(var apModeSwitchCount:number = "0" watch=false)
		(bind apModeSwitchCount "$event.switchCount" init=false watch=false (event "evOAModeFlapState"))
		(var apModeWindowStartTick:number = "0" watch=false)
		(bind apModeWindowStartTick "$event.windowStartTick" init=false watch=false (event "evOAModeFlapState"))
		(var apOvermatchHoldUntilTick:number = "0" watch=false)
		(bind apOvermatchHoldUntilTick "$event.holdUntilTick" init=false watch=false (event "evOAModeFlapState"))
		(var apModeComparable:bool = "_visible && isApRule && !apDeckSideOnly && apRawModeCode >= 0")
		(var apModeSwitched:bool = "apModeComparable && apLastModeCode >= 0 && apRawModeCode != apLastModeCode")
		(var apModeWindowExpired:bool = "apModeTick - apModeWindowStartTick > 40")
		(var apModeNextSwitchCount:number = "!apModeComparable ? 0 : apModeSwitched ? (apModeWindowExpired ? 1 : apModeSwitchCount + 1) : apModeWindowExpired ? 0 : apModeSwitchCount")
		(var apModeNextWindowStartTick:number = "!apModeComparable ? apModeTick : apModeWindowExpired ? apModeTick : apModeWindowStartTick")
		(var apModeNextHoldUntilTick:number = "!apModeComparable ? 0 : apModeSwitched && apModeNextSwitchCount >= 3 ? apModeTick + 60 : apOvermatchHoldUntilTick > apModeTick ? apOvermatchHoldUntilTick : 0")
		(dispatch evOAModeFlapState args = "{lastModeCode: apModeComparable ? apRawModeCode : -1, switchCount: apModeNextSwitchCount, windowStartTick: apModeNextWindowStartTick, holdUntilTick: apModeNextHoldUntilTick}" watch=false (event "timerEntity.timer.evFrequent"))
		(var apOvermatchModeHoldActive:bool = "isApRule && !apDeckSideOnly && apModeTick < apOvermatchHoldUntilTick")
		(var apMainBeltOnly:bool = "apRawMainBeltOnly && !apOvermatchModeHoldActive")
		(var apOvermatchRows:bool = "isApRule && !apDeckSideOnly && (apRawOvermatchRows || apOvermatchModeHoldActive)")
		(var showBowSternRow:bool = "!isApRule || apOvermatchRows")
		(var showDeckRow:bool = "!isApRule || apDeckSideOnly || apOvermatchRows")
		(var showSideRow:bool = "!isApRule || apDeckSideOnly || apOvermatchRows")
		(var showMainBeltRow:bool = "isApRule && apMainBeltOnly")
		(var showBeltRow:bool = "!isApRule || apOvermatchRows")
		(var mainBeltMinArmor:number = "hasTargetArmorRecord ? (_targetRecord.mbmn > 0 ? _targetRecord.mbmn : _targetRecord.xmn) : 0")
		(var mainBeltMaxArmor:number = "hasTargetArmorRecord ? (_targetRecord.mbmx > 0 ? _targetRecord.mbmx : _targetRecord.xmx) : 0")
		(var mainBeltSlopeMinDeg:number = "hasTargetArmorRecord ? _targetRecord.imn : 0")
		(var mainBeltSlopeMaxDeg:number = "hasTargetArmorRecord ? _targetRecord.imx : 0")
		(var mainBeltHeadingMaxDeg:number = "hasTargetArmorRecord ? _targetRecord.hmx : 0")
		(var yawHeelCapDeg:number = "!hasTargetArmorRecord ? 0 : _targetRecord.ty == 'B' ? 6.2 : _targetRecord.ty == 'C' ? 2.5 : _targetRecord.ty == 'D' ? 1.3 : _targetRecord.ty == 'A' ? 0.3 : 0")
		(var yawHeelK:number = "!hasTargetArmorRecord ? 0 : _targetRecord.ty == 'B' ? 1.1 : _targetRecord.ty == 'C' ? 0.3 : _targetRecord.ty == 'D' ? 0.13 : _targetRecord.ty == 'A' ? 0.05 : 0")
		(var yawHeelSpeedFactor:number = "_diffSpeedKnots > 0 ? min(1.3, max(0.4, _diffSpeedKnots / 30)) : 0.4")
		(var yawHeelDeg:number = "min(yawHeelCapDeg, yawHeelK * abs(_yawRateDegPerSec) * yawHeelSpeedFactor)")
		(var mainBeltDynamicSlopeMinDeg:number = "max(0, mainBeltSlopeMinDeg - yawHeelDeg)")
		(var mainBeltDynamicSlopeMaxDeg:number = "mainBeltSlopeMaxDeg + yawHeelDeg")
		(var mainBeltRawObliquityMinDeg:number = "max(0, predictedBeltObliquityDeg - mainBeltHeadingMaxDeg)")
		(var mainBeltRawObliquityMaxDeg:number = "min(90, predictedBeltObliquityDeg + mainBeltHeadingMaxDeg)")
		(var normalizedBeltObliquityMinDeg:number = "max(0, mainBeltRawObliquityMinDeg - (hasApTable ? _shellRecord.an : 0))")
		(var normalizedBeltObliquityMaxDeg:number = "max(0, mainBeltRawObliquityMaxDeg - (hasApTable ? _shellRecord.an : 0))")
		(var mainBeltVerticalObliquityMinDeg:number = "apImpactAngleDeg < mainBeltDynamicSlopeMinDeg ? mainBeltDynamicSlopeMinDeg - apImpactAngleDeg : apImpactAngleDeg > mainBeltDynamicSlopeMaxDeg ? apImpactAngleDeg - mainBeltDynamicSlopeMaxDeg : 0")
		(var mainBeltVerticalObliquityLowEdgeDeg:number = "abs(apImpactAngleDeg - mainBeltDynamicSlopeMinDeg)")
		(var mainBeltVerticalObliquityHighEdgeDeg:number = "abs(apImpactAngleDeg - mainBeltDynamicSlopeMaxDeg)")
		(var mainBeltVerticalObliquityMaxDeg:number = "mainBeltVerticalObliquityLowEdgeDeg >= mainBeltVerticalObliquityHighEdgeDeg ? mainBeltVerticalObliquityLowEdgeDeg : mainBeltVerticalObliquityHighEdgeDeg")
		(var mainBeltRicochetCosMin:number = "cos(min(80, mainBeltRawObliquityMinDeg) * 0.0174532925) * cos(min(80, mainBeltVerticalObliquityMinDeg) * 0.0174532925)")
		(var mainBeltRicochetCosMax:number = "cos(min(80, mainBeltRawObliquityMaxDeg) * 0.0174532925) * cos(min(80, mainBeltVerticalObliquityMaxDeg) * 0.0174532925)")
		(var mainBeltTrajectoryCosMin:number = "cos(min(80, normalizedBeltObliquityMinDeg) * 0.0174532925) * cos(min(80, mainBeltVerticalObliquityMinDeg) * 0.0174532925)")
		(var mainBeltTrajectoryCosMax:number = "cos(min(80, normalizedBeltObliquityMaxDeg) * 0.0174532925) * cos(min(80, mainBeltVerticalObliquityMaxDeg) * 0.0174532925)")
		(var mainBeltEffectiveMin:number = "mainBeltMinArmor > 0 ? mainBeltMinArmor / max(0.18, mainBeltTrajectoryCosMin) : 0")
		(var mainBeltEffectiveMax:number = "mainBeltMaxArmor > 0 ? mainBeltMaxArmor / max(0.18, mainBeltTrajectoryCosMax) : 0")
		(var mainBeltAllRicochet:bool = "hasApTable && _shellRecord.aa > 0 && mainBeltRicochetCosMin <= cos(_shellRecord.aa * 0.0174532925)")
		(var mainBeltAnyRicochet:bool = "hasApTable && _shellRecord.ar > 0 && mainBeltRicochetCosMax <= cos(_shellRecord.ar * 0.0174532925)")
		(var mainBeltOvermatchFull:bool = "hasRule && mainBeltMaxArmor > 0 && _ruleLimit >= mainBeltMaxArmor * _ruleScale")
		(var mainBeltOvermatchPartial:bool = "hasRule && mainBeltMinArmor > 0 && _ruleLimit >= mainBeltMinArmor * _ruleScale")
		(var mainBeltSymbol:str = "!hasTargetArmorRecord || !isApRule || mainBeltMaxArmor <= 0 ? '?' : mainBeltOvermatchFull ? '√' : mainBeltOvermatchPartial ? '△' : mainBeltAllRicochet ? '×' : apTrajectoryPenetrationMm * 0.95 >= mainBeltEffectiveMax && !mainBeltAnyRicochet ? '√' : apTrajectoryPenetrationMm * 1.05 >= mainBeltEffectiveMin ? '△' : '×'")
		(var mainBeltColor:number = "mainBeltSymbol == '√' ? 0x76D672 : mainBeltSymbol == '×' ? 0xFF6666 : mainBeltSymbol == '?' ? 0xB8B8B8 : 0xFFCC66")

		(var bowSternMinArmor:number = "hasTargetArmorRecord ? (_targetRecord.bmn <= _targetRecord.smn ? _targetRecord.bmn : _targetRecord.smn) : 0")
		(var bowSternMaxArmor:number = "hasTargetArmorRecord ? (_targetRecord.bmx >= _targetRecord.smx ? _targetRecord.bmx : _targetRecord.smx) : 0")
		(var bowSternOvermatchSymbol:str = "!hasTargetArmorRecord || !hasRule || bowSternMaxArmor <= 0 ? '?' : _ruleLimit >= bowSternMaxArmor * _ruleScale ? '√' : _ruleLimit >= bowSternMinArmor * _ruleScale ? '△' : '×'")
		(var bowSternSymbol:str = "isApRule ? bowSternOvermatchSymbol : bowSternOvermatchSymbol")
		(var bowSternColor:number = "bowSternSymbol == '√' ? 0x76D672 : bowSternSymbol == '×' ? 0xFF6666 : bowSternSymbol == '?' ? 0xB8B8B8 : 0xFFCC66")

		(var deckOvermatchSymbol:str = "!hasTargetArmorRecord || !hasRule || _targetRecord.dmx <= 0 ? '?' : _ruleLimit >= _targetRecord.dmx * _ruleScale ? '√' : _ruleLimit >= _targetRecord.dmn * _ruleScale ? '△' : '×'")
		(var deckImpactObliquityDeg:number = "max(0, 90 - apImpactAngleDeg)")
		(var apDeckAllRicochet:bool = "isApRule && hasApTable && _shellRecord.aa > 0 && deckImpactObliquityDeg >= _shellRecord.aa")
		(var apDeckAnyRicochet:bool = "isApRule && hasApTable && _shellRecord.ar > 0 && deckImpactObliquityDeg >= _shellRecord.ar")
		(var apDeckSymbol:str = "!hasTargetArmorRecord || !isApRule || _targetRecord.dmx <= 0 ? '?' : deckOvermatchSymbol == '√' ? '√' : deckOvermatchSymbol == '△' ? '△' : apDeckAllRicochet ? '×' : !hasApHorizontalTable ? '?' : apHorizontalPenetrationMm * 0.95 >= _targetRecord.dmx && !apDeckAnyRicochet ? '√' : apHorizontalPenetrationMm * 1.05 >= _targetRecord.dmn ? '△' : '×'")
		(var deckSymbol:str = "!isApRule ? deckOvermatchSymbol : apOvermatchRows ? deckOvermatchSymbol : apDeckSymbol")
		(var deckColor:number = "deckSymbol == '√' ? 0x76D672 : deckSymbol == '×' ? 0xFF6666 : deckSymbol == '?' ? 0xB8B8B8 : 0xFFCC66")

		(var sideOvermatchSymbol:str = "!hasTargetArmorRecord || !hasRule || _targetRecord.xmx <= 0 ? '?' : _ruleLimit >= _targetRecord.xmx * _ruleScale ? '√' : _ruleLimit >= _targetRecord.xmn * _ruleScale ? '△' : '×'")
		(var sideRawTrajectoryCos:number = "cos(min(80, predictedBeltObliquityDeg) * 0.0174532925) * cos(min(80, apImpactAngleDeg) * 0.0174532925)")
		(var sideNormalizedObliquityDeg:number = "max(0, predictedBeltObliquityDeg - (hasApTable ? _shellRecord.an : 0))")
		(var sideTrajectoryCos:number = "cos(min(80, sideNormalizedObliquityDeg) * 0.0174532925) * cos(min(80, apImpactAngleDeg) * 0.0174532925)")
		(var sideEffectiveMin:number = "hasTargetArmorRecord && _targetRecord.xmn > 0 ? _targetRecord.xmn / max(0.18, sideTrajectoryCos) : 0")
		(var sideEffectiveMax:number = "hasTargetArmorRecord && _targetRecord.xmx > 0 ? _targetRecord.xmx / max(0.18, sideTrajectoryCos) : 0")
		(var apSideAllRicochet:bool = "isApRule && hasApTable && _shellRecord.aa > 0 && sideRawTrajectoryCos <= cos(_shellRecord.aa * 0.0174532925)")
		(var apSideAnyRicochet:bool = "isApRule && hasApTable && _shellRecord.ar > 0 && sideRawTrajectoryCos <= cos(_shellRecord.ar * 0.0174532925)")
		(var apSideSymbol:str = "!hasTargetArmorRecord || !isApRule || _targetRecord.xmx <= 0 ? '?' : sideOvermatchSymbol == '√' ? '√' : sideOvermatchSymbol == '△' ? '△' : apSideAllRicochet ? '×' : apTrajectoryPenetrationMm * 0.95 >= sideEffectiveMax && !apSideAnyRicochet ? '√' : apTrajectoryPenetrationMm * 1.05 >= sideEffectiveMin ? '△' : '×'")
		(var sideSymbol:str = "!isApRule ? sideOvermatchSymbol : apOvermatchRows ? sideOvermatchSymbol : apSideSymbol")
		(var sideColor:number = "sideSymbol == '√' ? 0x76D672 : sideSymbol == '×' ? 0xFF6666 : sideSymbol == '?' ? 0xB8B8B8 : 0xFFCC66")

		(var bowBeltOvermatchSymbol:str = "!hasTargetArmorRecord || !hasRule ? '?' : !_targetRecord.bbp ? textNoBelt : _targetRecord.bbmx <= 0 ? '?' : _ruleLimit >= _targetRecord.bbmx * _ruleScale ? '√' : _ruleLimit >= _targetRecord.bbmn * _ruleScale ? '△' : '×'")
		(var sternBeltOvermatchSymbol:str = "!hasTargetArmorRecord || !hasRule ? '?' : !_targetRecord.bsp ? textNoBelt : _targetRecord.bsmx <= 0 ? '?' : _ruleLimit >= _targetRecord.bsmx * _ruleScale ? '√' : _ruleLimit >= _targetRecord.bsmn * _ruleScale ? '△' : '×'")
		(var bowBeltSymbol:str = "bowBeltOvermatchSymbol")
		(var sternBeltSymbol:str = "sternBeltOvermatchSymbol")
		(var bowBeltColor:number = "bowBeltSymbol == '√' ? 0x76D672 : bowBeltSymbol == '×' ? 0xFF6666 : bowBeltSymbol == '△' ? 0xFFCC66 : 0xB8B8B8")
		(var sternBeltColor:number = "sternBeltSymbol == '√' ? 0x76D672 : sternBeltSymbol == '×' ? 0xFF6666 : sternBeltSymbol == '△' ? 0xFFCC66 : 0xB8B8B8")
		(var beltLabelColor:number = "bowBeltColor == 0x76D672 && sternBeltColor == 0x76D672 ? 0x76D672 : bowBeltColor == 0xFF6666 && sternBeltColor == 0xFF6666 ? 0xFF6666 : bowBeltColor == 0xB8B8B8 && sternBeltColor == 0xB8B8B8 ? 0xB8B8B8 : 0xFFCC66")

		(var bowSternDisplayColor:number = "isDefenseMode && bowSternColor == 0x76D672 ? 0xFF6666 : isDefenseMode && bowSternColor == 0xFF6666 ? 0x76D672 : bowSternColor")
		(var deckDisplayColor:number = "isDefenseMode && deckColor == 0x76D672 ? 0xFF6666 : isDefenseMode && deckColor == 0xFF6666 ? 0x76D672 : deckColor")
		(var sideDisplayColor:number = "isDefenseMode && sideColor == 0x76D672 ? 0xFF6666 : isDefenseMode && sideColor == 0xFF6666 ? 0x76D672 : sideColor")
		(var mainBeltDisplayColor:number = "isDefenseMode && mainBeltColor == 0x76D672 ? 0xFF6666 : isDefenseMode && mainBeltColor == 0xFF6666 ? 0x76D672 : mainBeltColor")
		(var bowBeltDisplayColor:number = "isDefenseMode && bowBeltColor == 0x76D672 ? 0xFF6666 : isDefenseMode && bowBeltColor == 0xFF6666 ? 0x76D672 : bowBeltColor")
		(var sternBeltDisplayColor:number = "isDefenseMode && sternBeltColor == 0x76D672 ? 0xFF6666 : isDefenseMode && sternBeltColor == 0xFF6666 ? 0x76D672 : sternBeltColor")
		(var beltLabelDisplayColor:number = "bowBeltDisplayColor == 0x76D672 && sternBeltDisplayColor == 0x76D672 ? 0x76D672 : bowBeltDisplayColor == 0xFF6666 && sternBeltDisplayColor == 0xFF6666 ? 0xFF6666 : bowBeltDisplayColor == 0xB8B8B8 && sternBeltDisplayColor == 0xB8B8B8 ? 0xB8B8B8 : 0xFFCC66")

		(var bowSternText:str = "labelBowStern + '  ' + bowSternSymbol")
		(var deckText:str = "labelDeck + '  ' + deckSymbol")
		(var sideText:str = "labelSide + '  ' + sideSymbol")
		(var mainBeltSuffix:str = "hasTargetArmorRecord && (_targetRecord.ie || _targetRecord.hie) ? '*' : ''")
		(var bowBeltText:str = "labelBeltBow + bowBeltSymbol")
		(var sternBeltText:str = "labelBeltStern + sternBeltSymbol")
		(var visibleRuleRowsHeight:number = "(showBowSternRow ? 22 : 0) + (showDeckRow ? 22 : 0) + (showSideRow ? 22 : 0) + (showMainBeltRow ? 22 : 0) + (showBeltRow ? 22 : 0)")
		(var diagVisible:bool = "(showBowSternRow && bowSternSymbol == '?') || (showDeckRow && deckSymbol == '?') || (showSideRow && sideSymbol == '?') || (showMainBeltRow && mainBeltSymbol == '?') || (showBeltRow && (bowBeltSymbol == '?' || sternBeltSymbol == '?'))")
		(var diagText:str = "'D O' + (_ownDbKey != '' ? '1' : '0') + ' C' + toString(_ownCaliber) + ' T' + (hasTargetArmorRecord ? '1' : '0') + ' R' + toString(_ruleLimit) + ' S' + toString(_ruleScale) + ' B' + (hasTargetArmorRecord ? toString(bowSternMaxArmor) : '-') + ' K' + (hasTargetArmorRecord ? toString(_targetRecord.xmx) : '-') + ' AP' + toString(apPenetrationMm) + ' TP' + toString(apTrajectoryPenetrationMm) + ' HP' + toString(apHorizontalPenetrationMm) + ' A' + toString(round(_beltObliquityDeg)) + ' PA' + toString(round(predictedBeltObliquityDeg)) + ' RH' + toString(round(apRelativeHeadingDeg)) + ' FT' + toString(apFlightTimeSec) + ' YH' + toString(round(yawHeelDeg)) + ' H' + toString(round(mainBeltHeadingMaxDeg)) + ' I' + toString(apImpactAngleDeg)")
	)

	(bind visible "_visible")

	(block
		(style
			(position = "absolute")
			(bind left "_dragPosX")
			(bind top "_dragPosY")
			(width = 230)
			(bind height "visibleRuleRowsHeight + (diagVisible ? 22 : 4)")
			(bind scaleX "_scale")
			(bind scaleY "_scale")
		)

		(controller $Instance renderer='APOA_DraggableElement'
			(bind enabled "!_isPositionLocked")
			(args
				_elementName="OA_ELEMENT_NAME"
				_defaultPosition="_defaultPos"
			)
		)

		(mc contrast_panel
			(class $FullsizeAbsolute)
			(style
				(bind alpha "_backgroundAlpha")
				(hitTest = false)
			)
		)

		(block
			(style
				(width = 100%)
				(padding = [6, 9, 6, 9])
				(hitTest = false)
			)

			(element OA_Row _visible="showBowSternRow" _prefix="labelModePrefix" _text="bowSternText" _color="bowSternDisplayColor")
			(element OA_Row _visible="showDeckRow" _prefix="labelModePrefix" _text="deckText" _color="deckDisplayColor")
			(element OA_Row _visible="showSideRow" _prefix="labelModePrefix" _text="sideText" _color="sideDisplayColor")
			(element OA_MainBeltRow _visible="showMainBeltRow" _prefix="labelModePrefix" _labelText="labelMainBelt" _symbolText="mainBeltSymbol" _symbolColor="mainBeltDisplayColor" _suffixText="mainBeltSuffix")
			(element OA_BeltRow _visible="showBeltRow" _prefix="labelModePrefix" _labelText="labelBelt" _labelColor="beltLabelDisplayColor" _bowText="bowBeltText" _bowColor="bowBeltDisplayColor" _sternText="sternBeltText" _sternColor="sternBeltDisplayColor")
			(element OA_DiagRow _text="diagText" _visible="diagVisible")
		)

		(element OA_SettingsButton _visible="isMouseActive" _isOpen="settingsOpen"
			(style
				(left = -30px)
				(top = 20px)
			)
		)
		(element OA_SettingsPanel
			_visible="settingsOpen && isMouseActive"
			_languageIndex="_languageIndex"
			_displayMode="_displayMode"
			_scale="_scale"
			_backgroundAlpha="_backgroundAlpha"
			_isPositionLocked="_isPositionLocked"
			_debugLoadedEnabled="_debugLoadedEnabled"
		)
	)
)

(def element OA_LoadedIndicator(_visible:bool, _stageWidth:number, _stageHeight:number, _vehicleCount:number, _targetId:number) layout=true
	(bind visible "_visible")

	(block
		(style
			(position = "absolute")
			(left = 14px)
			(top = 118px)
			(width = 248px)
			(height = 24px)
			(hitTest = false)
		)

		(mc contrast_panel
			(class $FullsizeAbsolute)
			(style
				(alpha = 0.82)
			)
		)

		(tf
			(class $TextDefaultBold12NM)
			(style
				(position = "absolute")
				(left = 8px)
				(top = 3px)
				(textColor = 0xFFFFFF)
				(noTranslate = true)
				(width = 232px)
			)
			(bind text "'AP UI loaded | ships ' + toString(_vehicleCount) + ' | target ' + (_targetId > 0 ? toString(_targetId) : 'none')")
		)
	)
)

(def element OA_SettingsButton(_visible:bool, _isOpen:bool) layout=true
	(bind visible "_visible")

	(style
		(position = "absolute")
		(width = 26px)
		(height = 26px)
		(align = "middle|center")
		(hitTest = true)
	)

	(mc contrast_panel
		(class $FullsizeAbsolute)
		(style
			(bind alpha "_isOpen ? 1.0 : 0.62")
		)
	)

	(tf
		(class $TextDefaultBold12NM)
		(style
			(position = "absolute")
			(top = 5px)
			(textColor = 0xFFFFFF)
			(textAlign = "center")
			(noTranslate = true)
			(width = 26px)
		)
		(text = "CFG")
	)

	(dispatch evOASettingsToggle args="{}" dir="EventDirection.UP" on='mouseDown')
)

(def element OA_SettingsPanel(_visible:bool, _languageIndex:number, _displayMode:number, _scale:number, _backgroundAlpha:number, _isPositionLocked:bool, _debugLoadedEnabled:bool) layout=true
	(scope
		(var scaleIndex:number = "round((_scale - APOA_LOCAL_PREFS.SCALE.min) / APOA_LOCAL_PREFS.SCALE.step)")
		(var scaleMinusIndex:number = "max(0, scaleIndex - 1)")
		(var scalePlusIndex:number = "min(round((APOA_LOCAL_PREFS.SCALE.max - APOA_LOCAL_PREFS.SCALE.min) / APOA_LOCAL_PREFS.SCALE.step), scaleIndex + 1)")
		(var alphaIndex:number = "round((_backgroundAlpha - APOA_LOCAL_PREFS.BACKGROUND_ALPHA.min) / APOA_LOCAL_PREFS.BACKGROUND_ALPHA.step)")
		(var alphaMinusIndex:number = "max(0, alphaIndex - 1)")
		(var alphaPlusIndex:number = "min(round((APOA_LOCAL_PREFS.BACKGROUND_ALPHA.max - APOA_LOCAL_PREFS.BACKGROUND_ALPHA.min) / APOA_LOCAL_PREFS.BACKGROUND_ALPHA.step), alphaIndex + 1)")
	)

	(bind visible "_visible")

	(block
		(style
			(position = "absolute")
			(left = -198px)
			(top = 52px)
			(width = 190px)
			(height = 192px)
			(hitTest = true)
		)

		(mc contrast_panel
			(class $FullsizeAbsolute)
			(style
				(alpha = 0.94)
			)
		)

		(vblock
			(style
				(width = 100%)
				(padding = [8, 8, 8, 8])
			)
			(element OA_SettingsToggleRow _label="'Lang'" _valueText="_languageIndex == 1 ? 'ZH' : 'EN'" _prefKey="APOA_LOCAL_PREFS.LANGUAGE.key" _nextValue="_languageIndex == 1 ? 0 : 1")
			(element OA_SettingsToggleRow _label="'Mode'" _valueText="_displayMode == 1 ? 'Enemy' : 'My'" _prefKey="APOA_LOCAL_PREFS.MODE.key" _nextValue="_displayMode == 1 ? 0 : 1")
			(element OA_SettingsStepRow _label="'Scale'" _valueText="toString(round(_scale * 10) / 10) + 'x'" _prefKey="APOA_LOCAL_PREFS.SCALE.key" _minusValue="scaleMinusIndex" _plusValue="scalePlusIndex")
			(element OA_SettingsToggleRow _label="'Lock'" _valueText="_isPositionLocked ? 'ON' : 'OFF'" _prefKey="APOA_LOCAL_PREFS.DISABLE_DRAGDROP.key" _nextValue="_isPositionLocked ? 0 : 1")
			(element OA_SettingsStepRow _label="'Alpha'" _valueText="toString(round(_backgroundAlpha * 100)) + '%'" _prefKey="APOA_LOCAL_PREFS.BACKGROUND_ALPHA.key" _minusValue="alphaMinusIndex" _plusValue="alphaPlusIndex")
			(element OA_SettingsToggleRow _label="'Debug'" _valueText="_debugLoadedEnabled ? 'ON' : 'OFF'" _prefKey="APOA_LOCAL_PREFS.DEBUG_LOADED.key" _nextValue="_debugLoadedEnabled ? 0 : 1")
			(element OA_SettingsResetRow)
		)
	)
)

(def element OA_SettingsToggleRow(_label:str, _valueText:str, _prefKey:str, _nextValue:number) layout=true
	(scope
		(event evOASettingClicked)
	)

	(bindcall externalCall 'inputMapping.onAction' "['setUserPref', {'value': _nextValue + 0.00001, 'name': 'chatBoxWidth', 'subName': _prefKey}]" init=false watch=false (event "evOASettingClicked"))

	(hblock
		(style
			(width = 100%)
			(height = 24px)
			(align = "left|middle")
		)
		(element OA_SettingsLabel _text="_label")
		(element OA_SettingsValueButton _text="_valueText")
	)
)

(def element OA_SettingsStepRow(_label:str, _valueText:str, _prefKey:str, _minusValue:number, _plusValue:number) layout=true
	(scope
		(event evOASettingMinus)
		(event evOASettingPlus)
	)

	(bindcall externalCall 'inputMapping.onAction' "['setUserPref', {'value': _minusValue + 0.00001, 'name': 'chatBoxWidth', 'subName': _prefKey}]" init=false watch=false (event "evOASettingMinus"))
	(bindcall externalCall 'inputMapping.onAction' "['setUserPref', {'value': _plusValue + 0.00001, 'name': 'chatBoxWidth', 'subName': _prefKey}]" init=false watch=false (event "evOASettingPlus"))

	(hblock
		(style
			(width = 100%)
			(height = 24px)
			(align = "left|middle")
		)
		(element OA_SettingsLabel _text="_label")
		(element OA_SettingsMinusButton)
		(element OA_SettingsReadout _text="_valueText")
		(element OA_SettingsPlusButton)
	)
)

(def element OA_SettingsResetRow() layout=true
	(scope
		(event evOASettingClicked)
	)

	(bindcall externalCall 'inputMapping.onAction' "['clearUserPref', {'name': 'chatBoxWidth', 'subName': 'apOvermatchAssistant_positionX'}]" init=false watch=false (event "evOASettingClicked"))
	(bindcall externalCall 'inputMapping.onAction' "['clearUserPref', {'name': 'chatBoxWidth', 'subName': 'apOvermatchAssistant_positionY'}]" init=false watch=false (event "evOASettingClicked"))

	(hblock
		(style
			(width = 100%)
			(height = 24px)
			(align = "left|middle")
		)
		(element OA_SettingsLabel _text="'Reset'")
		(element OA_SettingsValueButton _text="'Position'")
	)
)

(def element OA_SettingsLabel(_text:str) layout=true
	(style
		(width = 58px)
		(height = 22px)
		(hitTest = false)
	)
	(tf
